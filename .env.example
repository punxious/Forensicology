# Copy to .env.local for local development. Never commit real values.
# Both secrets are optional in development (safe dev defaults are used) and
# REQUIRED in production. Generate each with:  openssl rand -base64 48

# Server-only key used to HMAC-hash case answers at build time and to check
# guesses at runtime. Build and runtime MUST use the same value. Changing it
# requires rebuilding cases (`pnpm case:build`, which `pnpm build` runs).
ANSWER_PEPPER=

# Signs the run-state cookie so players can't edit their own progress.
# Rotating it resets everyone's in-progress runs (Phase 1 only; Phase 2 moves runs to Postgres).
RUN_TOKEN_SECRET=

