# Copy to .env.local for local development. Never commit real values.
# For `pnpm dev` you can leave EVERYTHING blank: safe dev secrets, an embedded
# local database (PGlite, in .data/) and instant email sign-in are used.
# Generate secrets with:  openssl rand -base64 48

# --- Secrets (required in production) ----------------------------------------
# Server-only key used to HMAC-hash case answers at build time and to check
# guesses at runtime. Build and runtime MUST use the same value.
ANSWER_PEPPER=
# Signs the anonymous-player cookie (and the local dev sign-in cookie).
COOKIE_SECRET=

# --- Database (Supabase Postgres) ----------------------------------------------
# Runtime: the POOLED "transaction" connection string (port 6543).
DATABASE_URL=
# Migrations (`pnpm db:migrate`): the DIRECT connection string (port 5432).
# Falls back to DATABASE_URL if unset.
DATABASE_MIGRATION_URL=

# --- Auth (Supabase) -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only; needed to delete auth accounts when a player deletes their account.
SUPABASE_SERVICE_ROLE_KEY=
# Public site origin used in sign-in emails, e.g. https://forensicology.com.au
NEXT_PUBLIC_SITE_URL=
# Set to 1 after enabling the Google provider in Supabase.
NEXT_PUBLIC_AUTH_GOOGLE=

# --- Local-only switches (ignored on Vercel) ----------------------------------------
# Allow instant sign-in / the embedded database in a local *production* build.
# FX_DEV_AUTH=1
# FX_LOCAL_DB=1
# FX_PGLITE_DIR=memory://

